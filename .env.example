# CYBERNEXUS environment configuration (template).
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Application ---
APP_NAME=CYBERNEXUS
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database ---
# PostgreSQL (default, via docker-compose `postgres` service).
# If you change POSTGRES_PORT below, update the host port here to match.
DATABASE_URL=postgresql+psycopg://cybernexus:cybernexus@localhost:5432/cybernexus
# SQLite fallback (lightweight, no Docker):
# DATABASE_URL=sqlite:///./cybernexus.db

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_hex(48))"
# This placeholder must be changed before any deployment.
SECRET_KEY=change-me

# --- CORS ---
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT (used from Phase 2 on) ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Docker Compose (service only; do not change unless you know why) ---
# Host-side ports. Override POSTGRES_PORT / BACKEND_PORT / FRONTEND_PORT if a
# port is already taken by another project on your machine.
POSTGRES_DB=cybernexus
POSTGRES_USER=cybernexus
POSTGRES_PASSWORD=cybernexus
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Threat intelligence (Phase 12; optional external providers) ---
# Never hard-code provider keys in code. Leave empty to use local sample data.
# THREAT_INTEL_VIRUSTOTAL_API_KEY=
# THREAT_INTEL_ABUSEIPDB_API_KEY=